{
  "name": "character-engine-desktop",
  "productName": "인물 엔진",
  "private": true,
  "version": "1.0.0",
  "description": "인물 엔진 윈도우용",
  "author": "johnyuapril",
  "main": "main.cjs",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../dist','web',{recursive:true})\"",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.johnyuapril.characterengine",
    "productName": "인물 엔진",
    "artifactName": "CharacterEngine-Setup-${version}.${ext}",
    "files": ["main.cjs", "preload.cjs", "web/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "인물 엔진",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
